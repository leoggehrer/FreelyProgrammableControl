# AMPELSTEUERUNG: GRÜN 20S + GRÜN BLINKEN 5S + ORANGE 3S
# VEREINFACHTE VERSION MIT COUNTER UND TAKTGEBER

# INITIALISIERUNG (NUR EINMAL): COUNTER AUF 1 SETZEN
GETNOT M 10
CSET C 0 1
CMOV M 10 1

# TAKTGEBER 100MS (NUR EINMAL STARTEN)
GETNOT M 11
DUP
CSET T 10 100
CMOV M 11 1

# COUNTER HOCHZÄHLEN BEI JEDEM TAKT (100MS)
GET T 10
CINC C 0

# RESET NACH 280 TICKS (28 SEKUNDEN)
GT C 0 280
CSET C 0 1

# --- OUTPUT 0: GRÜN ---
# GRÜN KONSTANT: TICK 1-200 (0-20 SEKUNDEN)
GT C 0 0
LE C 0 200
AND
MOV O 0

# GRÜN BLINKEN: TICK 201-250 (20-25 SEKUNDEN)
# BLINK-TIMER NUR EINMAL STARTEN
GT C 0 200
LE C 0 250
AND
GETNOT M 12
AND
DUP
CSET T 0 500
CMOV M 12 1

# BLINK-TIMER RESET NACH ZUSTAND
GT C 0 250
CSET T 0 0
CMOV M 12 0

# GRÜN BLINKEN AUSGEBEN
GT C 0 200
LE C 0 250
AND
GET T 0
AND
MOV O 0

# --- OUTPUT 1: ORANGE ---
# ORANGE: TICK 251-280 (25-28 SEKUNDEN)
GT C 0 250
LE C 0 280
AND
MOV O 1
