      "id": "95e843dd-6d78-46ed-96d0-65384a1d83fd",
      "name": "WorkflowTrigger"
    },
    {
      "parameters": {
        "jsCode": "// Bereite das Dokument fuer den Vector Store vor\nconst input = $input.first().json;\n\n// Daten koennen als separate Felder ODER als einzelner query-String kommen\nlet pageContent = input.pageContent || '';\nlet title = input.title || '';\nlet category = input.category || '';\nlet level = input.level || '';\nlet tags = input.tags || '';\nlet commands = input.commands || '';\n\n// Fallback: Wenn alles in einem query-Feld steckt, verwende es als pageContent\nif (!pageContent && input.query) {\n  pageContent = input.query;\n}\n\n// Titel aus pageContent extrahieren wenn nicht separat\nif (!title && pageContent) {\n  const lines = pageContent.split('\\n').filter(l => l.trim());\n  if (lines.length > 0) {\n    let firstLine = lines[0].replace(/^Beschreibung:\\s*/i, '').trim();\n    title = firstLine.length > 80 ? firstLine.substring(0, 80) + '...' : firstLine;\n  }\n}\n\n// Befehle aus Code-Block extrahieren\nif (!commands && pageContent) {\n  const codeMatch = pageContent.match(/Code:\\s*\\n([\\s\\S]*?)(?:\\n\\n|\\nStack|\\nTest|$)/);\n  if (codeMatch) {\n    const codeLines = codeMatch[1].split('\\n').map(l => l.trim()).filter(l => l && !l.startsWith('#'));\n    const cmds = [...new Set(codeLines.map(l => l.split(/\\s+/)[0].toUpperCase()))];\n    commands = cmds.join(', ');\n  }\n}\n\nif (!title) title = 'FPC Pattern';\nif (!category) category = 'Grundlagen';\nif (!level) level = 'Einfach';\nif (!tags) tags = commands || 'FPC';\n\nreturn [{\n  json: {\n    pageContent: pageContent,\n    metadata: {\n      title: title,\n      category: category,\n      level: level,\n      tags: tags,\n      commands: commands,\n      verified: 'true',\n      source: 'self-learning',\n      createdAt: new Date().toISOString()\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
        0
      ],
