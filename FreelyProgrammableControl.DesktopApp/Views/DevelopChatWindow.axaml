<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FreelyProgrammableControl.DesktopApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="800"
        x:Class="FreelyProgrammableControl.DesktopApp.Views.DevelopChatWindow"
        x:DataType="vm:DevelopChatViewModel"
        Width="780"
        Height="900"
        Title="FPC Develop Pipeline – Chat">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="*,Auto,Auto,Auto" Margin="8">

    <!-- Verlauf -->
    <Border Grid.Row="0"
            BorderBrush="LightGray"
            BorderThickness="1"
            CornerRadius="5">
      <ScrollViewer x:Name="HistoryScroll"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Padding="6">
        <ItemsControl ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatMessageViewModel">
              <Border Margin="4"
                      Padding="8"
                      CornerRadius="6"
                      BorderBrush="LightGray"
                      BorderThickness="1">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Author}"
                               FontWeight="Bold"
                               FontSize="12" />
                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                               FontSize="11"
                               Foreground="Gray" />
                    <TextBlock Text="(läuft …)"
                               FontSize="11"
                               Foreground="DarkOrange"
                               IsVisible="{Binding IsPending}" />
                  </StackPanel>
                  <TextBox Text="{Binding Text, Mode=OneWay}"
                           IsReadOnly="True"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           BorderThickness="0"
                           Background="Transparent"
                           FontFamily="Courier New, Consolas, monospace"
                           FontSize="13" />
                  <Button Content="FPC-Code in Editor übernehmen"
                          IsVisible="{Binding HasFpcCode}"
                          Command="{Binding $parent[ItemsControl].((vm:DevelopChatViewModel)DataContext).ApplyCodeCommand}"
                          CommandParameter="{Binding}"
                          HorizontalAlignment="Left"
                          Margin="0,4,0,0" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Statusleiste -->
    <Border Grid.Row="1"
            Background="#FFF0F0F0"
            Padding="8,4"
            Margin="0,6,0,0"
            CornerRadius="4">
      <TextBlock Text="{Binding StatusText}"
                 FontSize="12"
                 Foreground="#FF303030" />
    </Border>

    <!-- Eingabezeile -->
    <Grid Grid.Row="2"
          ColumnDefinitions="*,Auto"
          Margin="0,6,0,0">
      <TextBox Grid.Column="0"
               x:Name="InputBox"
               Text="{Binding InputText, Mode=TwoWay}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinHeight="80"
               MaxHeight="200"
               Watermark="Frage / Anforderung an die FPC Develop Pipeline – Ctrl+Enter zum Senden" />
      <StackPanel Grid.Column="1"
                  Orientation="Vertical"
                  Spacing="4"
                  Margin="6,0,0,0"
                  VerticalAlignment="Stretch">
        <Button Content="Senden"
                Command="{Binding SendCommand}"
                Background="#FF4CAF50"
                Width="120"
                Height="36"
                ToolTip.Tip="Nachricht senden (Ctrl+Enter)" />
        <Button Content="Verlauf leeren"
                Command="{Binding ClearHistoryCommand}"
                Width="120"
                Height="32" />
      </StackPanel>
    </Grid>

    <!-- Busy-Indikator -->
    <ProgressBar Grid.Row="3"
                 Height="4"
                 Margin="0,6,0,0"
                 IsIndeterminate="True"
                 IsVisible="{Binding IsBusy}" />
  </Grid>
</Window>
