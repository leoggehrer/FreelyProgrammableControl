<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FreelyProgrammableControl.DesktopApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="800"
        x:Class="FreelyProgrammableControl.DesktopApp.Views.DevelopChatWindow"
        x:DataType="vm:DevelopChatViewModel"
  Width="880"
  Height="760"
  MinWidth="680"
  MinHeight="520"
        Title="FPC Develop Pipeline – Chat">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="10">

    <Border Grid.Row="0"
            Classes="card"
            Background="{StaticResource ToolbarBrush}"
            Padding="10,8"
            Margin="0,0,0,8">
      <TextBlock Text="FPC Develop Pipeline"
                 FontSize="15"
                 FontWeight="Bold" />
    </Border>

    <!-- Verlauf -->
    <Border Grid.Row="1"
            Classes="card">
      <ScrollViewer x:Name="HistoryScroll"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Padding="8">
        <ItemsControl ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatMessageViewModel">
              <Grid Margin="0,0,0,8">
                <Border Padding="10"
                        MaxWidth="620"
                        HorizontalAlignment="Right"
                        Background="{StaticResource UserBubbleBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        IsVisible="{Binding IsUser}">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Author}"
                                 FontWeight="Bold"
                                 FontSize="12" />
                      <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                 FontSize="11"
                                 Foreground="Gray" />
                    </StackPanel>
                    <TextBlock Text="{Binding Text, Mode=OneWay}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                  </StackPanel>
                </Border>

                <Border Padding="10"
                        MaxWidth="700"
                        HorizontalAlignment="Left"
                        Background="{StaticResource AssistantBubbleBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        IsVisible="{Binding IsAssistant}">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Author}"
                                 FontWeight="Bold"
                                 FontSize="12" />
                      <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                 FontSize="11"
                                 Foreground="Gray" />
                      <TextBlock Text="laeuft ..."
                                 FontSize="11"
                                 Foreground="#FFB7791F"
                                 IsVisible="{Binding IsPending}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Text, Mode=OneWay}"
                               TextWrapping="Wrap"
                               FontFamily="Courier New, Consolas, monospace"
                               FontSize="13" />
                    <Button Content="FPC-Code in Editor uebernehmen"
                            Classes="action-info"
                            IsVisible="{Binding HasFpcCode}"
                            Command="{Binding $parent[ItemsControl].((vm:DevelopChatViewModel)DataContext).ApplyCodeCommand}"
                            CommandParameter="{Binding}"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Statusleiste -->
    <Border Grid.Row="2"
            Classes="card"
            Background="{StaticResource ToolbarBrush}"
            Padding="8,4"
            Margin="0,6,0,0"
            CornerRadius="4">
      <TextBlock Text="{Binding StatusText}"
                 FontSize="12"
                 Foreground="#FF303030" />
    </Border>

    <!-- Eingabezeile -->
    <Grid Grid.Row="3"
          ColumnDefinitions="*,Auto"
          Margin="0,6,0,0">
      <TextBox Grid.Column="0"
               x:Name="InputBox"
               Text="{Binding InputText, Mode=TwoWay}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               MinHeight="80"
               MaxHeight="200"
               Watermark="Frage / Anforderung an die FPC Develop Pipeline – Ctrl+Enter zum Senden" />
      <StackPanel Grid.Column="1"
                  Orientation="Vertical"
                  Spacing="4"
                  Margin="6,0,0,0"
                  VerticalAlignment="Stretch">
        <Button Content="Senden"
          Classes="action-success"
                Command="{Binding SendCommand}"
                Width="120"
                Height="36"
                ToolTip.Tip="Nachricht senden (Ctrl+Enter)" />
        <Button Content="Verlauf leeren"
                Command="{Binding ClearHistoryCommand}"
                Width="120"
                Height="32" />
      </StackPanel>
    </Grid>

    <!-- Busy-Indikator -->
    <ProgressBar Grid.Row="4"
                 Height="4"
                 Margin="0,6,0,0"
                 IsIndeterminate="True"
                 IsVisible="{Binding IsBusy}" />
  </Grid>
</Window>
