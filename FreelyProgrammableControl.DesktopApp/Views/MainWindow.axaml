<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FreelyProgrammableControl.DesktopApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dock="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        xmlns:conv="using:FreelyProgrammableControl.DesktopApp.Converters"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
        x:Class="FreelyProgrammableControl.DesktopApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1000"
        Height="1000"
        Title="FreelyProgrammableControl">

  <Window.Resources>
    <conv:BoolToColorConverter x:Key="BoolToColorConverter"/>
  </Window.Resources>

  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainWindowViewModel/>
  </Design.DataContext>
  <DockPanel>

    <!-- Menüleiste -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Datei">
        <MenuItem Header="_Neu" Command="{Binding NewCommand}"/>
        <MenuItem Header="_Öffnen" Command="{Binding OpenCommand}"/>
        <MenuItem Header="_Speichern" Command="{Binding SaveCommand}"/>
        <Separator/>
        <MenuItem Header="_Beenden" Command="{Binding ExitCommand}"/>
      </MenuItem>
      <MenuItem Header="_Bearbeiten">
        <MenuItem Header="_Rückgängig" IsEnabled="False"/>
        <MenuItem Header="_Wiederholen" IsEnabled="False"/>
        <Separator/>
        <MenuItem Header="_Kopieren" IsEnabled="False"/>
        <MenuItem Header="_Einfügen" IsEnabled="False"/>
        <MenuItem Header="_Ausschneiden" IsEnabled="False"/>
      </MenuItem>
      <MenuItem Header="_Hilfe">
        <MenuItem Header="_Über" IsEnabled="False"/>
      </MenuItem>
    </Menu>

    <!-- Hauptinhalt -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="140" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="50" />
        <RowDefinition Height="*" />
        <RowDefinition Height="100" />
        <RowDefinition Height="30" />
      </Grid.RowDefinitions>

      <StackPanel x:Name="Inputs" Grid.Row="1" Grid.Column="0" Margin="10">
        <TextBlock Text="Inputs" FontWeight="Bold"/>
        <ItemsControl ItemsSource="{Binding Inputs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox IsEnabled="{Binding IsModifiable}" 
                        IsChecked="{Binding Value}"
                        Content="{Binding Label}"
                        Margin="0,2,0,2"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
		
      <!-- Mittlerer Bereich mit mehrzeiligem Textfeld -->
      <StackPanel x:Name="Buttons"
            Grid.Row="0"
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="8"
            Margin="5">
        <Button Width="90"
                Command="{Binding StartCommand}">Start</Button>
        <Button Width="90"
                Command="{Binding StopCommand}"
                IsEnabled="{Binding IsRunning}">Stop</Button>
        <Button Width="90"
                Command="{Binding ParseCommand}">Parse</Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="Cycle (ms)" VerticalAlignment="Center" />
          <NumericUpDown Width="80" Minimum="1" Maximum="5000" Increment="10" Value="{Binding CycleTime}"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1">
      </StackPanel>
      <TextBox Text="{Binding SourceCode}"
               Grid.Row="1"
               Grid.Column="1"
               VerticalAlignment="Stretch"
               HorizontalAlignment="Stretch"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               FontFamily="Consolas"
               Margin="5" />
      <TextBox Text="{Binding ParseOutput}"
               Grid.Row="2"
               Grid.Column="1"
               IsReadOnly="True"
               VerticalAlignment="Stretch"
               HorizontalAlignment="Stretch"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               FontFamily="Consolas"
               Margin="5" />
      <StackPanel Grid.Row="1" Grid.Column="2" Margin="10" Spacing="6">
        <TextBlock Text="Outputs" FontWeight="Bold"/>
        <ItemsControl ItemsSource="{Binding Outputs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{Binding Value, Converter={StaticResource BoolToColorConverter}}" 
                      CornerRadius="4" 
                      Padding="8" 
                      Margin="0,2,0,2">
                <TextBlock Text="{Binding Label}" Foreground="Black"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Statusleiste -->
      <TextBlock x:Name="StatusLeft"
                 Grid.Row="3"
                 Grid.Column="0"
                 Text=""
                 Margin="10"/>
      <TextBlock x:Name="Status"
                 Grid.Row="3"
                 Grid.Column="1"
                 Text="{Binding StatusText}"
                 Margin="10"/>
      <TextBlock x:Name="StatusRight"
                 Grid.Row="3"
                 Grid.Column="2"
                 Text=""
                 Margin="10"/>
    </Grid>
  </DockPanel>

</Window>
