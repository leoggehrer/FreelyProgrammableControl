<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FreelyProgrammableControl.DesktopApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dock="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
        x:Class="FreelyProgrammableControl.DesktopApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
  Width="1280"
  Height="860"
  MinWidth="980"
  MinHeight="680"
        Title="FreelyProgrammableControl">

  <Window.KeyBindings>
    <!-- File Operations -->
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    
    <!-- Edit Operations -->
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
    <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
    <KeyBinding Gesture="Ctrl+X" Command="{Binding CutCommand}" />
    
    <!-- Debug Operations -->
    <KeyBinding Gesture="F5" Command="{Binding StartCommand}" />
    <KeyBinding Gesture="Shift+F5" Command="{Binding StopCommand}" />
    <KeyBinding Gesture="F7" Command="{Binding ParseCommand}" />
    <KeyBinding Gesture="F10" Command="{Binding StepCommand}" />
    <KeyBinding Gesture="F1" Command="{Binding AboutCommand}" />

    <!-- AI Operations -->
    <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding OpenDevelopChatCommand}" />
  </Window.KeyBindings>

  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainWindowViewModel/>
  </Design.DataContext>
  <DockPanel LastChildFill="True">

    <!-- Menu bar (File, Edit, Help) -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Command="{Binding NewCommand}" HotKey="Ctrl+N"/>
        <MenuItem Header="_Open">
          <MenuItem Header="_Local File..." Command="{Binding OpenCommand}" HotKey="Ctrl+O"/>
          <MenuItem Header="Load From Google drive" Command="{Binding LoadFromGoogleDriveCommand}"/>
        </MenuItem>
        <MenuItem Header="_Save" Command="{Binding SaveCommand}" HotKey="Ctrl+S"/>
        <MenuItem Header="Save _As...">
          <MenuItem Header="_Local File..." Command="{Binding SaveAsCommand}" HotKey="Ctrl+Shift+S"/>
          <MenuItem Header="Save To Google drive" Command="{Binding SaveToGoogleDriveCommand}"/>
          <MenuItem Header="In Vector Store speichern" Command="{Binding SaveToVektorCommand}"/>
        </MenuItem>
        <MenuItem Header="Labels">
          <MenuItem Header="_Import Labels..." Command="{Binding ImportLabelsCommand}" HotKey="Ctrl+Shift+I"/>
          <MenuItem Header="_Export Labels..." Command="{Binding ExportLabelsCommand}" HotKey="Ctrl+Shift+E"/>
        </MenuItem>
        <Separator/>
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" HotKey="Alt+F4"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Command="{Binding UndoCommand}" HotKey="Ctrl+Z"/>
        <MenuItem Header="_Redo" Command="{Binding RedoCommand}" HotKey="Ctrl+Y"/>
        <Separator/>
        <MenuItem Header="_Copy" Command="{Binding CopyCommand}" HotKey="Ctrl+C"/>
        <MenuItem Header="_Paste" Command="{Binding PasteCommand}" HotKey="Ctrl+V"/>
        <MenuItem Header="Cu_t" Command="{Binding CutCommand}" HotKey="Ctrl+X"/>
      </MenuItem>
      <MenuItem Header="_AI">
        <MenuItem Header="FPC Develop _Chat..." Command="{Binding OpenDevelopChatCommand}" HotKey="Ctrl+Shift+C"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" Command="{Binding AboutCommand}" HotKey="F1"/>
      </MenuItem>
    </Menu>

    <!-- Main content with inputs, editor, and outputs -->
    <Grid Margin="8,8,8,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" MinWidth="140" />
        <ColumnDefinition Width="15" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="15" />
        <ColumnDefinition Width="Auto" MinWidth="140" />
      </Grid.ColumnDefinitions>

      <!-- Control bar (grouped actions) -->
      <Border Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="5"
              Classes="card"
              Background="{StaticResource ToolbarBrush}"
              Padding="10,8"
              Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Width="120"
                    Height="32"
                    Classes="action-primary"
                    Command="{Binding OpenDevelopChatCommand}"
                    ToolTip.Tip="FPC Develop Chat oeffnen (Ctrl+Shift+C)"
                    Content="AI Chat" />
          </StackPanel>

          <Separator Width="1" Margin="6,2" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Width="100"
                    Height="32"
                    Classes="action-success"
                    Command="{Binding StartCommand}"
                    ToolTip.Tip="Programm starten (F5)"
                    Content="Start" />
            <Button Width="100"
                    Height="32"
                    Classes="action-danger"
                    Command="{Binding StopCommand}"
                    ToolTip.Tip="Programm stoppen (Shift+F5)"
                    Content="Stop" />
            <Button Width="100"
                    Height="32"
                    Classes="action-info"
                    Command="{Binding ParseCommand}"
                    ToolTip.Tip="Programm parsen (F7)"
                    Content="Parse" />
          </StackPanel>

          <Separator Width="1" Margin="6,2" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <ToggleButton Width="120"
                          Height="32"
                          HorizontalContentAlignment="Center"
                          Classes="action-warning"
                          IsEnabled="{Binding IsDebugEnabled}"
                          IsChecked="{Binding DebugEnabled}"
                          Content="{Binding DebugButtonText}"
                          ToolTip.Tip="Debug-Modus umschalten" />
            <NumericUpDown Width="140"
                           Height="32"
                           Increment="1"
                           FormatString="0000"
                           Minimum="{Binding MinLineNumber}"
                           Maximum="{Binding MaxLineNumber}"
                           Value="{Binding CurrentLineNumber}"
                           IsEnabled="{Binding DebugEnabled}"
                           ToolTip.Tip="Zeilennummer" />
            <Button Width="110"
                    Height="32"
                    Classes="action-warning"
                    Command="{Binding StepCommand}"
                    ToolTip.Tip="Einzelschritt ausfuehren (F10)"
                    Content="Step" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Inputs -->
      <Border Grid.Row="1" Grid.Column="0" 
              Classes="card"
              Margin="0,0,8,8" 
              Padding="5"
              MinWidth="140">
        <StackPanel>
          <TextBlock Text="Inputs" 
                     FontWeight="Bold" 
                     FontSize="14"
                     Margin="5,5,5,10"
                     HorizontalAlignment="Center"/>
          <ComboBox Margin="5,0,5,8"
                    ItemsSource="{Binding InputPageLabels}"
                    SelectedIndex="{Binding SelectedInputPageIndex}"
                    IsVisible="{Binding HasMultipleInputPages}" />
          <ItemsControl ItemsSource="{Binding VisibleInputs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InputDeviceViewModel">
                <Border Background="Transparent" 
                        Margin="5,1"
                        DoubleTapped="Input_DoubleTapped">
                  <CheckBox IsEnabled="{Binding IsEnabled}"
                            IsChecked="{Binding IsChecked}"
                            Content="{Binding Label}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Splitter between input and source code -->
      <GridSplitter Grid.Row="1"
                    Grid.Column="1"
                    Width="5"
                    Margin="0,0,5,8"
                    Background="{StaticResource PanelBorderBrush}"
                    ResizeDirection="Columns" />

      <!-- Editor area (source/output) with splitter -->
      <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Source -->
          <Border Grid.Row="0" Grid.Column="0"
                  Classes="card">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="Source Code" 
                         FontWeight="Bold" 
                         FontSize="12"
                         Margin="10,10,10,5"
                         Foreground="Gray"/>
              <TextBox x:Name="SourceTextBox"
                       Grid.Row="1"
                       VerticalAlignment="Stretch"
                       HorizontalAlignment="Stretch"
                       AcceptsTab="True"
                       AcceptsReturn="True"
                       TextWrapping="NoWrap"
                       FontFamily="Courier New, Consolas, monospace"
                       FontSize="14"
                       Margin="5"
                       DoubleTapped="SourceTextBox_DoubleTapped"
                       PointerReleased="SourceTextBox_PointerReleased"
                       IsReadOnly="{Binding IsSourceReadOnly}"
                       Text="{Binding SourceText, Mode=TwoWay}" />
            </Grid>
          </Border>
          <!-- Splitter between source and output -->
          <GridSplitter Grid.Row="1" 
                        Grid.Column="0" 
                        Height="5"
                        Margin="5,5,5,5"
                        Background="{StaticResource PanelBorderBrush}" 
                        ResizeDirection="Rows" />
          <!-- Output -->
          <Border Grid.Row="2" Grid.Column="0"
                  Classes="card">
            <TabControl>
              <TabItem Header="Output" FontSize="12">
                <TextBox IsReadOnly="True"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Courier New, Consolas, monospace"
                         FontSize="14"
                         Margin="5"
                         Text="{Binding OutputText}" />
              </TabItem>
              <TabItem Header="Execution State" FontSize="12">
                <Grid ColumnDefinitions="2*,*,*,*,*"
                      Margin="5">
                  <TextBox Grid.Column="0"
                           IsReadOnly="True"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch"
                           AcceptsReturn="True"
                           TextWrapping="NoWrap"
                           FontFamily="Courier New, Consolas, monospace"
                           FontSize="14"
                           Margin="0,0,4,0"
                           Text="{Binding ExecutionStatePart1}" />
                  <TextBox Grid.Column="1"
                           IsReadOnly="True"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch"
                           AcceptsReturn="True"
                           TextWrapping="NoWrap"
                           FontFamily="Courier New, Consolas, monospace"
                           FontSize="14"
                           Margin="0,0,4,0"
                           Text="{Binding ExecutionStatePart2}" />
                  <TextBox Grid.Column="2"
                           IsReadOnly="True"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch"
                           AcceptsReturn="True"
                           TextWrapping="NoWrap"
                           FontFamily="Courier New, Consolas, monospace"
                           FontSize="14"
                           Margin="0,0,4,0"
                           Text="{Binding ExecutionStatePart3}" />
                  <TextBox Grid.Column="3"
                           IsReadOnly="True"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch"
                           AcceptsReturn="True"
                           TextWrapping="NoWrap"
                           FontFamily="Courier New, Consolas, monospace"
                           FontSize="14"
                           Margin="0,0,4,0"
                           Text="{Binding ExecutionStatePart4}" />
                  <TextBox Grid.Column="4"
                           IsReadOnly="True"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch"
                           AcceptsReturn="True"
                           TextWrapping="NoWrap"
                           FontFamily="Courier New, Consolas, monospace"
                           FontSize="14"
                           Text="{Binding ExecutionStatePart5}" />
                </Grid>
              </TabItem>
            </TabControl>
          </Border>
      </Grid>

      <GridSplitter Grid.Row="1"
                    Grid.Column="3"
                    Width="5"
                    Margin="8,0,0,8"
                    Background="{StaticResource PanelBorderBrush}"
                    ResizeDirection="Columns" />

      <!-- Outputs -->
      <Border Grid.Row="1" Grid.Column="4" 
              Classes="card"
              Margin="8,0,0,8" 
              Padding="5"
              MinWidth="140">
        <StackPanel>
          <TextBlock Text="Outputs" 
                     FontWeight="Bold" 
                     FontSize="14"
                     Margin="5,5,5,10"
                     HorizontalAlignment="Center"/>
          <ComboBox Margin="5,0,5,8"
                    ItemsSource="{Binding OutputPageLabels}"
                    SelectedIndex="{Binding SelectedOutputPageIndex}"
                    IsVisible="{Binding HasMultipleOutputPages}" />
          <ItemsControl ItemsSource="{Binding VisibleOutputs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OutputDeviceViewModel">
                <Border Background="Transparent" 
                        Margin="5,1"
                        DoubleTapped="Output_DoubleTapped">
                  <RadioButton GroupName="{Binding GroupName}"
                               IsEnabled="True"
                               IsHitTestVisible="False"
                               Focusable="False"
                               IsChecked="{Binding IsChecked, Mode=OneWay}"
                               Content="{Binding Label}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Status bar -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
              Background="{StaticResource ToolbarBrush}"
              BorderBrush="{StaticResource PanelBorderBrush}"
              BorderThickness="0,1,0,0"
              MinHeight="30"
              Padding="10,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusLeft"
                     Grid.Column="0"
                     Text="File:"
                     FontWeight="Bold"
                     Foreground="#FF202020"
                     FontSize="12"
                     Margin="0,0,10,0"/>
          <TextBlock Grid.Column="1"
                     Text="{Binding StatusText}"
                     Foreground="#FF303030"
                     FontSize="12"/>
          <TextBlock x:Name="StatusRight"
                     Grid.Column="2"
                     Text=""
                     Foreground="#FF303030"
                     FontSize="12"/>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>