<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FreelyProgrammableControl.DesktopApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dock="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
        x:Class="FreelyProgrammableControl.DesktopApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1000"
        Height="900"
        Title="FreelyProgrammableControl.DesktopApp">

  <Window.KeyBindings>
    <!-- File Operations -->
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    
    <!-- Edit Operations -->
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
    <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
    <KeyBinding Gesture="Ctrl+X" Command="{Binding CutCommand}" />
    
    <!-- Debug Operations -->
    <KeyBinding Gesture="F5" Command="{Binding StartCommand}" />
    <KeyBinding Gesture="Shift+F5" Command="{Binding StopCommand}" />
    <KeyBinding Gesture="F7" Command="{Binding ParseCommand}" />
    <KeyBinding Gesture="F10" Command="{Binding StepCommand}" />
    <KeyBinding Gesture="F1" Command="{Binding AboutCommand}" />
  </Window.KeyBindings>

  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainWindowViewModel/>
  </Design.DataContext>
  <DockPanel>

    <!-- Menu bar (File, Edit, Help) -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Command="{Binding NewCommand}" HotKey="Ctrl+N"/>
        <MenuItem Header="_Open">
          <MenuItem Header="_Local File..." Command="{Binding OpenCommand}" HotKey="Ctrl+O"/>
          <MenuItem Header="Load From Google drive" Command="{Binding LoadFromGoogleDriveCommand}"/>
        </MenuItem>
        <MenuItem Header="_Save" Command="{Binding SaveCommand}" HotKey="Ctrl+S"/>
        <MenuItem Header="Save _As...">
          <MenuItem Header="_Local File..." Command="{Binding SaveAsCommand}" HotKey="Ctrl+Shift+S"/>
          <MenuItem Header="Save To Google drive" Command="{Binding SaveToGoogleDriveCommand}"/>
        </MenuItem>
        <Separator/>
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" HotKey="Alt+F4"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Command="{Binding UndoCommand}" HotKey="Ctrl+Z"/>
        <MenuItem Header="_Redo" Command="{Binding RedoCommand}" HotKey="Ctrl+Y"/>
        <Separator/>
        <MenuItem Header="_Copy" Command="{Binding CopyCommand}" HotKey="Ctrl+C"/>
        <MenuItem Header="_Paste" Command="{Binding PasteCommand}" HotKey="Ctrl+V"/>
        <MenuItem Header="Cu_t" Command="{Binding CutCommand}" HotKey="Ctrl+X"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" Command="{Binding AboutCommand}" HotKey="F1"/>
      </MenuItem>
    </Menu>

    <!-- Main content with inputs, editor, and outputs -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="140" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="30" />
        <RowDefinition Height="*" />
        <RowDefinition Height="30" />
      </Grid.RowDefinitions>

      <!-- Inputs -->
      <Border Grid.Row="1" Grid.Column="0" 
              Margin="5" 
              Padding="5"
              BorderBrush="LightGray" 
              BorderThickness="1"
              CornerRadius="5">
        <StackPanel>
          <TextBlock Text="Inputs" 
                     FontWeight="Bold" 
                     FontSize="14"
                     Margin="5,5,5,10"
                     HorizontalAlignment="Center"/>
          <ComboBox Margin="5,0,5,8"
                    ItemsSource="{Binding InputPageLabels}"
                    SelectedIndex="{Binding SelectedInputPageIndex}"
                    IsVisible="{Binding HasMultipleInputPages}" />
          <ItemsControl ItemsSource="{Binding VisibleInputs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InputDeviceViewModel">
                <Border Background="Transparent" 
                        Margin="5,1"
                        DoubleTapped="Input_DoubleTapped">
                  <CheckBox IsEnabled="{Binding IsEnabled}"
                            IsChecked="{Binding IsChecked}"
                            Content="{Binding Label}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <!-- Control bar (Start/Stop/Parse) -->
      <StackPanel x:Name="Buttons"
                  Grid.Row="0"
                  Grid.Column="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Margin="5">
        <Button Width="100"
                Height="28"
                Margin="5,0"
                HorizontalContentAlignment="Center"
                Background="#FF4CAF50"
                Command="{Binding StartCommand}"
                ToolTip.Tip="Programm starten (F5)">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="▶" FontSize="14" />
            <TextBlock Text="Start" />
          </StackPanel>
        </Button>
        <Button Width="100"
                Height="28"
                Margin="5,0"
                HorizontalContentAlignment="Center"
                Background="#FFF44336"
                Command="{Binding StopCommand}"
                ToolTip.Tip="Programm stoppen (Shift+F5)">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="■" FontSize="14" />
            <TextBlock Text="Stop" />
          </StackPanel>
        </Button>
        <Button Width="100"
                Height="28"
                Margin="5,0"
                HorizontalContentAlignment="Center"
                Background="#FF2196F3"
                Command="{Binding ParseCommand}"
                ToolTip.Tip="Programm parsen (F7)">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="✓" FontSize="14" />
            <TextBlock Text="Parse" />
          </StackPanel>
        </Button>
        <ToggleButton Width="100"
                      Height="28"
                      Margin="5,0"
                      HorizontalContentAlignment="Center"
                      IsEnabled="{Binding IsDebugEnabled}"
                      IsChecked="{Binding DebugEnabled}"
                      Content="{Binding DebugButtonText}"
                      ToolTip.Tip="Debug-Modus umschalten" />
        <NumericUpDown Width="140"
                       Height="28"
                       Margin="5,0"
                       Increment="1"
                       FormatString="0000"
                       Minimum="{Binding MinLineNumber}"
                       Maximum="{Binding MaxLineNumber}"
                       Value="{Binding CurrentLineNumber}"
                       IsEnabled="{Binding DebugEnabled}"
                       ToolTip.Tip="Zeilennummer" />
        <Button Width="100"
                Height="28"
                Margin="5,0"
                HorizontalContentAlignment="Center"
                Background="#FFFF9800"
                Command="{Binding StepCommand}"
                ToolTip.Tip="Einzelschritt ausführen (F10)">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="➡" FontSize="14" />
            <TextBlock Text="Step" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Editor area (source/output) with splitter -->
      <Grid Grid.Row="1" Grid.Column="1" Margin="5">
		  <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Source -->
          <Border Grid.Row="0" Grid.Column="0"
                  BorderBrush="LightGray" 
                  BorderThickness="1"
                  CornerRadius="5">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="Source Code" 
                         FontWeight="Bold" 
                         FontSize="12"
                         Margin="10,10,10,5"
                         Foreground="Gray"/>
              <TextBox x:Name="SourceTextBox"
                       Grid.Row="1"
                       VerticalAlignment="Stretch"
                       HorizontalAlignment="Stretch"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       FontFamily="Courier New, Consolas, monospace"
                       FontSize="14"
                       Margin="5"
                       IsReadOnly="{Binding IsSourceReadOnly}"
                       Text="{Binding SourceText, Mode=TwoWay}" />
            </Grid>
          </Border>
          <!-- Splitter between source and output -->
          <GridSplitter Grid.Row="1" Grid.Column="0" Margin="0,5" Height="3"
                        Background="LightGray" 
                        ResizeDirection="Rows" />
          <!-- Output -->
          <Border Grid.Row="2" Grid.Column="0"
                  BorderBrush="LightGray" 
                  BorderThickness="1"
                  CornerRadius="5">
            <TabControl>
              <TabItem Header="Output" FontSize="12">
                <TextBox IsReadOnly="True"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Courier New, Consolas, monospace"
                         FontSize="14"
                         Margin="5"
                         Text="{Binding OutputText}" />
              </TabItem>
              <TabItem Header="Execution State" FontSize="12">
                <TextBox IsReadOnly="True"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Courier New, Consolas, monospace"
                         FontSize="14"
                         Margin="5"
                         Text="{Binding ExecutionState}" />
              </TabItem>
            </TabControl>
          </Border>
      </Grid>

      <!-- Outputs -->
      <Border Grid.Row="1" Grid.Column="2" 
              Margin="5" 
              Padding="5"
              BorderBrush="LightGray" 
              BorderThickness="1"
              CornerRadius="5">
        <StackPanel>
          <TextBlock Text="Outputs" 
                     FontWeight="Bold" 
                     FontSize="14"
                     Margin="5,5,5,10"
                     HorizontalAlignment="Center"/>
          <ComboBox Margin="5,0,5,8"
                    ItemsSource="{Binding OutputPageLabels}"
                    SelectedIndex="{Binding SelectedOutputPageIndex}"
                    IsVisible="{Binding HasMultipleOutputPages}" />
          <ItemsControl ItemsSource="{Binding VisibleOutputs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OutputDeviceViewModel">
                <Border Background="Transparent" 
                        Margin="5,1"
                        DoubleTapped="Output_DoubleTapped">
                  <RadioButton GroupName="{Binding GroupName}"
                               IsEnabled="True"
                               IsHitTestVisible="False"
                               Focusable="False"
                               IsChecked="{Binding IsChecked, Mode=OneWay}"
                               Content="{Binding Label}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Status bar -->
      <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
              Background="LightGray"
              BorderBrush="Gray"
              BorderThickness="0,1,0,0"
              Padding="10,5">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusLeft"
                     Grid.Column="0"
                     Text="File:"
                     FontWeight="Bold"
                     Foreground="#FF202020"
                     FontSize="12"
                     Margin="0,0,10,0"/>
          <TextBlock Grid.Column="1"
                     Text="{Binding StatusText}"
                     Foreground="#FF303030"
                     FontSize="12"/>
          <TextBlock x:Name="StatusRight"
                     Grid.Column="2"
                     Text=""
                     Foreground="#FF303030"
                     FontSize="12"/>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>

</Window>
