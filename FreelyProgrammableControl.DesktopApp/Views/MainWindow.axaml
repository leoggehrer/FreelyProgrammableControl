<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FreelyProgrammableControl.DesktopApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dock="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
        x:Class="FreelyProgrammableControl.DesktopApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1000"
        Height="750"
        Title="FreelyProgrammableControl.DesktopApp">

  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainWindowViewModel/>
  </Design.DataContext>
  <DockPanel>

    <!-- Menüleiste -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Datei">
        <MenuItem Header="_Neu" Command="{Binding NewCommand}"/>
        <MenuItem Header="_Öffnen" Command="{Binding OpenCommand}"/>
        <MenuItem Header="_Speichern" Command="{Binding SaveCommand}"/>
        <MenuItem Header="Speichern _unter..." Command="{Binding SaveAsCommand}"/>
        <Separator/>
        <MenuItem Header="_Beenden" Command="{Binding ExitCommand}"/>
      </MenuItem>
      <MenuItem Header="_Bearbeiten">
        <MenuItem Header="_Rückgängig" Command="{Binding UndoCommand}"/>
        <MenuItem Header="_Wiederholen" Command="{Binding RedoCommand}"/>
        <Separator/>
        <MenuItem Header="_Kopieren" Command="{Binding CopyCommand}"/>
        <MenuItem Header="_Einfügen" Command="{Binding PasteCommand}"/>
        <MenuItem Header="_Ausschneiden" Command="{Binding CutCommand}"/>
      </MenuItem>
      <MenuItem Header="_Hilfe">
        <MenuItem Header="_Über" Command="{Binding AboutCommand}"/>
      </MenuItem>
    </Menu>

    <!-- Hauptinhalt -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="140" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="30" />
        <RowDefinition Height="*" />
        <RowDefinition Height="30" />
      </Grid.RowDefinitions>

      <ItemsControl Grid.Row="1" Grid.Column="0" Margin="10" ItemsSource="{Binding Inputs}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:InputDeviceViewModel">
            <CheckBox IsEnabled="{Binding IsEnabled}"
                      IsChecked="{Binding IsChecked}"
                      Content="{Binding Label}"
                      Margin="0" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- Mittlerer Bereich mit mehrzeiligem Textfeld -->
      <StackPanel x:Name="Buttons"
                  Grid.Row="0"
                  Grid.Column="1"
                  Orientation="Horizontal">
        <Button Width="100"
                HorizontalContentAlignment="Center"
                Command="{Binding StartCommand}">Start</Button>
        <Button Width="100"
                HorizontalContentAlignment="Center"
                Command="{Binding StopCommand}">Stop</Button>
        <Button Width="100"
                HorizontalContentAlignment="Center"
                Command="{Binding ParseCommand}">Parse</Button>
      </StackPanel>

      <Grid Grid.Row="1" Grid.Column="1">
		  <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBox Grid.Row="0"
                   Grid.Column="0"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   FontFamily="Consolas"
                   Margin="5"
                   IsReadOnly="{Binding IsSourceReadOnly}"
                   Text="{Binding SourceText, Mode=TwoWay}" />
          <GridSplitter Grid.Row="1" Grid.Column="0" Background="LightGray" ResizeDirection="Rows" />
          <TextBox Grid.Row="2"
                   Grid.Column="0"
                   IsReadOnly="True"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   FontFamily="Consolas"
                   Margin="5"
                   Text="{Binding OutputText}" />
      </Grid>

      <ItemsControl Grid.Row="1" Grid.Column="2" Margin="10" ItemsSource="{Binding Outputs}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OutputDeviceViewModel">
            <RadioButton GroupName="{Binding GroupName}"
                         IsEnabled="False"
                         IsChecked="{Binding IsChecked}"
                         Content="{Binding Label}"
                         Margin="0" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Statusleiste -->
      <TextBlock x:Name="StatusLeft"
                 Grid.Row="4"
                 Grid.Column="0"
                 Text=""
                 Margin="10"/>
      <TextBlock Grid.Row="4"
                 Grid.Column="1"
                 Text="{Binding StatusText}"
                 Margin="10"/>
      <TextBlock x:Name="StatusRight"
                 Grid.Row="4"
                 Grid.Column="2"
                 Text=""
                 Margin="10"/>
    </Grid>
  </DockPanel>

</Window>
